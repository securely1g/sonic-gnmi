load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//tools/bazel:native_test.bzl", "native_go_test")
load("//tools/bazel:source_files.bzl", "source_files")

go_library(
    name = "download",
    srcs = ["download.go"],
    importpath = "github.com/sonic-net/sonic-gnmi/internal/download",
    visibility = ["//:__subpackages__"],
)

alias(
    name = "go_default_library",
    actual = ":download",
    visibility = ["//:__subpackages__"],
)

native_go_test(
    name = "download_test",
    srcs = ["download_test.go"],
    embed = [":download"],
)

source_files()

load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//tools/bazel:native_test.bzl", "native_go_test")
load("//tools/bazel:source_files.bzl", "source_files")

go_library(
    name = "redisopts",
    srcs = ["redis_pool.go"],
    importpath = "github.com/sonic-net/sonic-gnmi/internal/redisopts",
    visibility = ["//:__subpackages__"],
    deps = [
        "@com_github_golang_glog//:glog",
        "@com_github_redis_go_redis_v9//:go-redis",
    ],
)

alias(
    name = "go_default_library",
    actual = ":redisopts",
    visibility = ["//:__subpackages__"],
)

native_go_test(
    name = "redisopts_test",
    srcs = ["redis_pool_test.go"],
    embed = [":redisopts"],
    deps = ["@com_github_redis_go_redis_v9//:go-redis"],
)

source_files()

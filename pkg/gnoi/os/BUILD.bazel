load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("//tools/bazel:native_test.bzl", "native_go_test")
load("//tools/bazel:source_files.bzl", "source_files")

go_library(
    name = "os",
    srcs = ["os.go"],
    importpath = "github.com/sonic-net/sonic-gnmi/pkg/gnoi/os",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/exec",
        "@com_github_golang_glog//:glog",
        "@com_github_openconfig_gnoi//os",
        "@org_golang_google_grpc//codes",
        "@org_golang_google_grpc//status",
    ],
)

native_go_test(
    name = "os_test",
    srcs = [
        "os_monkey_test.go",
        "os_test.go",
    ],
    embed = [":os"],
    deps = [
        "//pkg/exec",
        "@com_github_agiledragon_gomonkey_v2//:gomonkey",
        "@com_github_openconfig_gnoi//os",
    ],
)

source_files()

"""Expose source files beside their owning BUILD package for the source TAR."""

def source_files():
    native.filegroup(
        name = "owner_source_files",
        srcs = native.glob(
            [
                "**/*.go",
                "**/*.proto",
                "**/*.py",
                "**/*.j2",
                "**/*.i",
                "**/*.h",
                "**/*.c",
                "**/*.cc",
                "**/*.cpp",
                "**/*.json",
                "**/*.yaml",
                "**/*.yml",
                "**/*.xml",
                "**/*.patch",
                "**/*.md",
                "**/*.bzl",
                "**/*.sh",
                "**/*.txt",
                "**/Makefile",
                "Makefile",
                "go.mod",
                "go.sum",
                "go.bazel.work",
                "MODULE.bazel",
                ".bazelrc",
                ".bazelversion",
                "BUILD.bazel",
                "LICENSE*",
                "COPYING*",
                "debian/**",
            ],
            exclude = [
                "bazel-*/**",
                "build/**",
                "vendor/**",
                ".git/**",
                "tests/consumer/**",
                "**/__pycache__/**",
                "**/sonic_internal.pb.go",
                "**/sonic_debug.pb.go",
                "**/oras.pb.go",
            ],
            allow_empty = True,
        ),
        visibility = ["//visibility:public"],
    )
